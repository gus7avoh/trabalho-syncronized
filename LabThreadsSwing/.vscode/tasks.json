{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Compilar",
      "type": "shell",
      "command": "javac",
      "args": [
        "-d", "out",
        "-sourcepath", "src",
        "src/com/appcadastro/labthreadsswing/LabThreadsSwing.java",
        "src/com/appcadastro/labthreadsswing/TelaBanco.java"
      ],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": "$javac"
    },
    {
      "label": "Executar",
      "type": "shell",
      "command": "java",
      "args": [
        "-cp", "out",
        "com.appcadastro.labthreadsswing.LabThreadsSwing"
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "dependsOn": "Compilar",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}
